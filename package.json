    "deploy:prod": "node scripts/deploy-prod.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "freela:stripe:dev": "node scripts/freela-stripe-setup.mjs --environment development",
    "freela:stripe:preview": "node scripts/freela-stripe-setup.mjs --environment preview",
    "freela:stripe:production:prepare": "node scripts/freela-stripe-setup.mjs --environment production"
